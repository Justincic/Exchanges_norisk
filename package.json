{
  "name": "funding-arbitrage-dashboard",
  "version": "0.1.0",
  "description": "Dashboard for monitoring cross-exchange perpetual funding arbitrage opportunities.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justincic/Exchanges_norisk.git"
  },
  "bugs": {
    "url": "https://github.com/Justincic/Exchanges_norisk/issues"
  },
  "homepage": "https://github.com/Justincic/Exchanges_norisk#readme",
  "keywords": [
    "funding-rate",
    "arbitrage",
    "crypto",
    "perpetuals",
    "react",
    "vite"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lucide-react": "^0.560.0",
    "tsx": "^4.21.0",
    "vite": "^7.2.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
